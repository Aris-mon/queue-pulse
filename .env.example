# Application
SECRET_KEY=change-this-to-a-long-random-secret
FLASK_DEBUG=0
APP_VERSION=10.20.22
HOST=0.0.0.0
PORT=5000

# Database
# SQLite is the default for the Windows POC.
DATABASE_URL=sqlite:///instance/pdl_intelligence.db

# Microsoft Graph / Entra ID dedicated mailbox
# Production uses app-only/client-credentials authentication.
# Required application permissions: Mail.Read, Group.Read.All, GroupMember.Read.All
# GRAPH_CLIENT_SECRET is the CLIENT SECRET VALUE, not the Secret ID.
# GRAPH_MAILBOX is the dedicated mailbox SMTP address, e.g. mailbox@company.com.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=

# Legacy Outlook fallback (not used when GRAPH_MAILBOX is configured)
OUTLOOK_MAILBOX=
# Outlook ReceivedTime wall-clock is normalized to this operational timezone.
OUTLOOK_TIMEZONE=Asia/Kolkata
OUTLOOK_TIMEZONE_OFFSET_MINUTES=330
SYNC_DAYS=7
SYNC_LIMIT=1000
# Incremental sync overlap; manual Sync Outlook performs a full SYNC_DAYS scan.
SYNC_OVERLAP_MINUTES=120
INTERNAL_DOMAINS=hpe.com
OUTLOOK_SYNC_ENABLED=1
SYNC_INTERVAL_MINUTES=5

# Default admin bootstrap
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=ChangeMe-Immediately
ADMIN_NAME=System Administrator

# Auto-sync is controlled from Administration > Automatic Outlook Sync.
# This value is retained only as a legacy compatibility setting.
SCHEDULER_ENABLED=0

SYNC_BATCH_SIZE=50

# AI Intelligence Engine
# local/ollama uses an Ollama-compatible local inference server.
# rules disables LLM calls while keeping deterministic intelligence active.
AI_PROVIDER=local
AI_MODEL=qwen3:8b
AI_BASE_URL=http://127.0.0.1:11434
AI_TIMEOUT=300
AI_TEMPERATURE=0.0
AI_THINK=false
AI_KEEP_ALIVE=10m
AI_CONFIDENCE_THRESHOLD=0.72
AI_FALLBACK_MODE=rules
AI_SCAN_MODE=all_customer

# Optional: explicit Ollama executable path on Windows Server if it is not in PATH.
OLLAMA_EXE=

# Local AI / RAG (no email content is sent to remote AI/vector services)
AI_LOCAL_ONLY=true
AI_RAG_ENABLED=true
AI_RAG_TOP_K=4
AI_RAG_MIN_SCORE=0.55
AI_RAG_PATH=instance/chroma
AI_EMBEDDING_MODEL_PATH=models/all-MiniLM-L6-v2
AI_EMBEDDING_DEVICE=cpu
AI_RAG_AUTO_INDEX=true
AI_RAG_SYNC_INTERVAL_SECONDS=60
AI_NUM_CTX=8192
AI_MAX_TOKENS=256
AI_PROMPT_VERSION=v5-rag-langgraph
